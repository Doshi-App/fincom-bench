# FinCom Bench.
#
# `submissions/` is deliberately NOT ignored. It is the audit record behind
# every leaderboard row, and a reader who wants to check a score needs the
# transcript that produced it. Keep one run directory per model per phase.

# Python build artifacts from the harness.
__pycache__/
*.py[cod]

*.env

# Node / Next.js build artifacts for the website.
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Human meta-eval labels are never published (see README "The dataset").
harness/pipeline/human-labels.csv

# Run logs from the harness driver scripts.
logs/
.vercel
